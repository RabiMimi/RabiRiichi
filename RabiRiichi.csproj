<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <DebugType>portable</DebugType>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="RabiRiichi.Server\**" />
    <Compile Remove="RabiRiichi.Tests\**" />
    <Compile Remove="RabiRiichi.Arena\**" />
    <Compile Remove="RabiRiichi.Benchmarks\**" />
    <EmbeddedResource Remove="RabiRiichi.Server\**" />
    <EmbeddedResource Remove="RabiRiichi.Tests\**" />
    <EmbeddedResource Remove="RabiRiichi.Arena\**" />
    <EmbeddedResource Remove="RabiRiichi.Benchmarks\**" />
    <None Remove="RabiRiichi.Server\**" />
    <None Remove="RabiRiichi.Tests\**" />
    <None Remove="RabiRiichi.Arena\**" />
    <None Remove="RabiRiichi.Benchmarks\**" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf ProtoRoot="Protos" Include="Protos\**\*.proto" Exclude="Protos\Server\**\*.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.82.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
  </ItemGroup>
  
</Project>
